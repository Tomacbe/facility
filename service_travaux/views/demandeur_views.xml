<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demande_nouvelle_form" model="ir.ui.view">
        <field name="name">travaux.demande.nouvelle.form</field>
        <field name="model">travaux.demande.nouvelle</field>
        <field name="arch" type="xml">
            <form string="Nouvelle demande">
                <sheet>
                    <div class="oe_title"><h1>Nouvelle demande au service technique</h1></div>
                    <p class="text-muted">Décrivez le problème et l'endroit. Le service technique l'examine, vous répond dans le fil de la demande et vous prévient de son avancement.</p>
                    <group>
                        <group string="Le problème">
                            <field name="titre" placeholder="Ex. fuite au plafond, porte bloquée"/>
                            <field name="description" placeholder="Ce que vous constatez, depuis quand, s'il y a un danger…"/>
                            <field name="categorie_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="photo" widget="image" options="{'size': [0, 180]}"/>
                        </group>
                        <group string="L'endroit et vous">
                            <field name="lieu_id" options="{'no_create': True, 'no_open': True}" placeholder="École du Centre, Maison communale…"/>
                            <field name="adresse" placeholder="2e étage, classe 3 ; ou une adresse"/>
                            <field name="contact"/>
                            <field name="service" placeholder="Ex. École du Centre, Service population"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_envoyer" type="object" string="Envoyer la demande" class="btn-primary"/>
                    <button special="cancel" string="Annuler"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_demande_nouvelle" model="ir.actions.act_window">
        <field name="name">Nouvelle demande</field>
        <field name="res_model">travaux.demande.nouvelle</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_mes_demandes_list" model="ir.ui.view">
        <field name="name">travaux.demande.mes.list</field>
        <field name="model">travaux.demande</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Mes demandes" create="0" edit="0" delete="0" decoration-muted="state in ('close', 'transferee')" decoration-warning="state == 'precision'">
                <header>
                    <button name="%(action_demande_nouvelle)d" type="action" string="Nouvelle demande" class="btn-primary" display="always"/>
                </header>
                <field name="name" string="N°"/>
                <field name="titre"/>
                <field name="lieu_id" optional="show"/>
                <field name="adresse" optional="hide"/>
                <field name="create_date" string="Envoyée le" widget="date"/>
                <field name="state" column_invisible="1"/>
                <field name="etat_demandeur" string="Où en est-elle ?"/>
            </list>
        </field>
    </record>
    <record id="view_mes_demandes_form" model="ir.ui.view">
        <field name="name">travaux.demande.mes.form</field>
        <field name="model">travaux.demande</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Ma demande" create="0" edit="0" delete="0">
                <sheet>
                    <field name="state" invisible="1"/>
                    <div class="oe_title">
                        <div class="text-muted"><field name="name" readonly="1"/> · envoyée le <field name="create_date" widget="date" readonly="1"/></div>
                        <h1><field name="titre" readonly="1"/></h1>
                        <h4 class="text-primary"><field name="etat_demandeur"/></h4>
                    </div>
                    <group>
                        <group>
                            <field name="lieu_id" readonly="1" invisible="not lieu_id" options="{'no_open': True}"/>
                            <field name="adresse" readonly="1" string="Où exactement"/>
                            <field name="service_demandeur" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_prevue" readonly="1" invisible="not date_prevue" string="Intervention prévue le"/>
                            <field name="equipe_id" readonly="1" invisible="not equipe_id" options="{'no_open': True}" string="Par l'équipe"/>
                        </group>
                    </group>
                    <field name="description" readonly="1"/>
                    <div class="d-flex gap-3 mt-3">
                        <field name="photo_avant" widget="image" readonly="1" invisible="not photo_avant" options="{'size': [0, 220]}"/>
                        <field name="photo_apres" widget="image" readonly="1" invisible="not photo_apres" options="{'size': [0, 220]}"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mes_demandes" model="ir.actions.act_window">
        <field name="name">Mes demandes</field>
        <field name="res_model">travaux.demande</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('demandeur_user_id', '=', uid)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_mes_demandes_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_mes_demandes_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune demande pour l'instant</p>
            <p>« Nouvelle demande » : décrivez le problème et l'endroit, le service technique s'en occupe.</p>
        </field>
    </record>
</odoo>
