<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_circuit_list" model="ir.ui.view">
        <field name="name">travaux.circuit.list</field>
        <field name="model">travaux.circuit</field>
        <field name="arch" type="xml">
            <list string="Tournées de zones">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="equipe_id"/>
                <field name="saison_label"/>
                <field name="avancement" string="Tour en cours"/>
                <field name="en_saison" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="view_circuit_form" model="ir.ui.view">
        <field name="name">travaux.circuit.form</field>
        <field name="model">travaux.circuit</field>
        <field name="arch" type="xml">
            <form string="Tournée de zones">
                <header>
                    <button name="action_nouveau_tour" type="object" string="Recommencer un tour" confirm="Repartir de zéro : toutes les zones redeviennent « à faire » ?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_passages" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <div class="o_stat_info"><span class="o_stat_text">Passages</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Ex. Tonte des espaces verts"/></h1></div>
                    <group>
                        <group>
                            <field name="equipe_id" options="{'no_create': True}"/>
                            <field name="mode" widget="radio"/>
                            <label for="mois_debut"/>
                            <div class="d-flex gap-2 align-items-center">
                                <field name="mois_debut" class="oe_inline" placeholder="toute l'année"/>
                                <span invisible="not mois_debut">à</span>
                                <field name="mois_fin" class="oe_inline" invisible="not mois_debut" required="mois_debut"/>
                            </div>
                        </group>
                        <group>
                            <field name="delai_alerte"/>
                            <field name="tour_no"/>
                            <field name="avancement"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Zones, dans l'ordre de passage"/>
                    <field name="zone_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="photo" widget="image" options="{'size': [0, 44]}" string="Photo"/>
                            <field name="name" placeholder="Ex. Parc du Centre"/>
                            <field name="lieu_id" options="{'no_create': True}" optional="show"/>
                            <field name="note" optional="show"/>
                            <field name="duree" widget="float_time" optional="show"/>
                            <field name="dernier_passage"/>
                        </list>
                    </field>
                    <div class="text-muted small mt-2">Une par une : sur le terrain, l'équipe appuie sur « Démarrer » puis « Fait » pour chaque zone ; chaque zone faite donne un bon de travail avec ses heures.
                        En lot : l'équipe démarre la tournée entière et indique 50, 80 ou 100 % en terminant. Une zone non faite n'est pas reportée.
                        La photo sert de vignette à la zone sur le terrain.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_circuit_search" model="ir.ui.view">
        <field name="name">travaux.circuit.search</field>
        <field name="model">travaux.circuit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipe_id"/>
                <filter name="archived" string="Archivées" domain="[('active', '=', False)]"/>
                <group><filter name="grp_equipe" string="Équipe" context="{'group_by': 'equipe_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_circuits" model="ir.actions.act_window">
        <field name="name">Tournées de zones</field>
        <field name="res_model">travaux.circuit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Donnez à une équipe sa liste de zones à entretenir</p>
            <p>Par exemple « Tonte des espaces verts » pour les jardiniers, d'avril à octobre. L'équipe coche chaque zone faite ;
               vous voyez le dernier passage de chaque zone et l'avancement du tour.</p>
        </field>
    </record>
    <record id="view_passage_list" model="ir.ui.view">
        <field name="name">travaux.passage.list</field>
        <field name="model">travaux.passage</field>
        <field name="arch" type="xml">
            <list string="Passages" create="0" edit="0">
                <field name="date"/>
                <field name="zone_id"/>
                <field name="circuit_id" optional="show"/>
                <field name="equipe_id"/>
                <field name="tour_no"/>
                <field name="user_id" optional="hide"/>
                <field name="heures" widget="float_time" optional="show" sum="Total"/>
                <field name="photo" widget="image" options="{'size': [0, 40]}" optional="show"/>
            </list>
        </field>
    </record>
</odoo>
